{
  "name": "ghg-vscode",
  "displayName": "ghg",
  "description": "Use ghg in a dedicated VS Code workspace view.",
  "version": "0.1.1",
  "publisher": "sacca97",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghg",
          "title": "ghg",
          "icon": "./media/ghg.svg"
        }
      ]
    },
    "views": {
      "ghg": [
        {
          "type": "webview",
          "id": "ghg.chatView",
          "name": "Chat"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ghg.newSession",
          "icon": "$(add)",
          "when": "view == ghg.chatView",
          "group": "navigation@1"
        },
        {
          "command": "ghg.resumeSession",
          "icon": "$(history)",
          "when": "view == ghg.chatView",
          "group": "navigation@2"
        },
        {
          "command": "ghg.refreshModels",
          "icon": "$(sync)",
          "when": "view == ghg.chatView",
          "group": "navigation@3"
        },
        {
          "command": "ghg.openSettings",
          "icon": "$(settings-gear)",
          "when": "view == ghg.chatView",
          "group": "navigation@4"
        }
      ]
    },
    "commands": [
      {
        "command": "ghg.newSession",
        "title": "ghg: New Session",
        "icon": "$(add)"
      },
      {
        "command": "ghg.resumeSession",
        "title": "ghg: Resume Session",
        "icon": "$(history)"
      },
      {
        "command": "ghg.refreshModels",
        "title": "ghg: Refresh Models",
        "icon": "$(sync)"
      },
      {
        "command": "ghg.openSettings",
        "title": "ghg: Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "ghg",
      "properties": {
        "ghg.binaryPath": {
          "type": "string",
          "default": "ghg",
          "description": "Path to the ghg executable."
        },
        "ghg.defaultRole": {
          "type": "string",
          "enum": ["default", "smart", "fast", "tiny"],
          "default": "fast",
          "description": "Model role selected for new chats."
        },
        "ghg.defaultMode": {
          "type": "string",
          "enum": ["execute", "plan", "review"],
          "default": "execute",
          "description": "Mode selected for new chats."
        },
        "ghg.defaultEffort": {
          "type": "string",
          "enum": ["", "low", "medium", "high"],
          "default": "",
          "description": "Thinking effort selected for new chats."
        },
        "ghg.sandbox": {
          "type": "string",
          "enum": ["", "read-only", "workspace-write", "danger-full-access"],
          "default": "",
          "description": "Sandbox mode passed to the next ghg worker."
        },
        "ghg.network": {
          "type": "string",
          "enum": ["", "deny", "host"],
          "default": "",
          "description": "Network policy passed to the next ghg worker."
        },
        "ghg.approval": {
          "type": "string",
          "enum": ["", "ask", "auto", "never"],
          "default": "",
          "description": "Exceptional capability approval policy."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
